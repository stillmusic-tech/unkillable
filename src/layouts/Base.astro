---
import '@fontsource/saira/400.css'
import '@fontsource/saira/600.css'
import '@fontsource/saira/700.css'
import '@fontsource/saira/800.css'
import '@fontsource/jetbrains-mono/400.css'
import '@fontsource/jetbrains-mono/700.css'

interface Props {
  title: string
}
const { title } = Astro.props
const nav = [
  { href: '/attack', label: 'Attack the Network' },
  { href: '/fundamentals', label: 'Bitcoin Fundamentals' },
  { href: '/about', label: 'About' },
]
const current = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Attack Bitcoin yourself and watch what actually happens." />
    <title>{title} · Unkillable</title>
  </head>
  <body>
    <nav>
      <a class="brand" href="/" aria-current={current === '/' ? 'page' : undefined}>UNKILLABLE</a>
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={
              current === item.href || (item.href !== '/' && current.startsWith(item.href))
                ? 'page'
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #07090d;
    /* Panels are translucent glass over the body's grid + glow backdrop. */
    --panel: rgba(255, 255, 255, 0.03);
    --well: rgba(3, 5, 9, 0.55);
    --line: rgba(255, 255, 255, 0.08);
    --line-bright: rgba(255, 255, 255, 0.14);
    --text: #f3f4f6;
    --dim: #9ca3af;
    --orange: #f7931a;
    --glow: 0 0 20px rgba(247, 147, 26, 0.15);
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }
  * {
    box-sizing: border-box;
  }
  html {
    overscroll-behavior-y: none;
  }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family:
      'Saira',
      system-ui,
      -apple-system,
      sans-serif;
    line-height: 1.5;
  }
  /* Depth instead of flat black: a faint grid plus two warm radial glows on a
     fixed layer behind everything. (Not background-attachment: fixed — Chrome
     paints that black on scroll-snap pages.) */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      radial-gradient(50rem 30rem at 75% -5%, rgba(247, 147, 26, 0.06), transparent 65%),
      radial-gradient(42rem 28rem at 12% 108%, rgba(247, 147, 26, 0.05), transparent 65%);
    background-size:
      44px 44px,
      44px 44px,
      auto,
      auto;
  }
  /* Type floor: nothing renders below 16px. Buttons and inputs default to the
     browser's 13px, and sup/sub to `smaller`, so they need saying explicitly.
     A page's own rule for a control still wins — this only sets the floor. */
  button,
  input,
  select,
  textarea {
    font-family: inherit;
    font-size: 1rem;
  }
  sup,
  sub {
    font-size: 1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 1.5rem;
    padding: 1.35rem 1.5rem;
    border-bottom: 1px solid var(--line);
    background: rgba(7, 9, 13, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  /* The brand is the home link: dim like the others, orange only when current. */
  nav .brand {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  nav a {
    color: var(--dim);
    text-decoration: none;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    color: var(--orange);
  }
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  h1,
  h2,
  h3 {
    letter-spacing: -0.02em;
  }
  h1 {
    font-size: 2rem;
  }
  a {
    color: var(--orange);
  }
  .stub {
    color: var(--dim);
    border: 1px dashed var(--line-bright);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-top: 1.5rem;
  }
  .cta {
    display: inline-block;
    background: var(--orange);
    color: #0a0a0a;
    font-weight: 700;
    font-size: 1.15rem;
    padding: 0.9rem 2rem;
    border-radius: 8px;
    text-decoration: none;
  }

  /* ---- Bitcoin Fundamentals shared pieces. The chapter carousel and the
     mid-attack popup are JS-mounted (innerHTML / set:html) and the popup can
     open on ANY page, so their styles live here, not in fundamentals.astro. */

  /* Text-only chapter visual (e.g. the big 21,000,000). */
  .fvisual .viz-row,
  #fund-body .viz-row {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--well);
    border-radius: 8px;
    padding: 1rem;
  }
  .viz-big {
    font-family: var(--mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--orange);
  }

  /* One idea at a time: the slide on top, controls in a footer bar beneath —
     counter left, pill dots centre, arrow buttons right. */
  .fcarousel {
    margin-top: 1rem;
  }
  .fc-viewport {
    min-height: 9rem;
    display: flex;
    align-items: center;
  }
  .fc-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    margin-top: 1rem;
    padding-top: 0.9rem;
  }
  .fc-count {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--dim);
    min-width: 3.4rem;
  }
  .fc-slide {
    display: none;
    width: 100%;
    color: var(--text);
    line-height: 1.6;
  }
  .fc-slide.is-active {
    display: block;
  }
  .fc-slide p {
    margin: 0 0 0.8rem;
  }
  .fc-slide p:last-child {
    margin-bottom: 0;
  }
  .fc-slide ul {
    margin: 0 0 0.8rem;
    padding-left: 1.2rem;
  }
  .fc-slide li {
    margin-bottom: 0.35rem;
  }
  /* The question that hands off to the next chapter. */
  .fc-slide .fhook {
    color: var(--orange);
    font-weight: 600;
  }
  .fc-arrow {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--well);
    border: 1px solid var(--line-bright);
    border-radius: 8px;
    color: var(--dim);
    font-size: 1.25rem;
    line-height: 1;
    padding: 0;
    cursor: pointer;
  }
  .fc-arrow:hover:not(:disabled) {
    color: var(--orange);
    border-color: var(--orange);
  }
  .fc-arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .fc-dots {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 0.45rem;
  }
  /* Pill indicators: the active slide's pill stretches out. */
  .fc-dot {
    width: 12px;
    height: 4px;
    border-radius: 2px;
    border: none;
    padding: 0;
    background: var(--line-bright);
    cursor: pointer;
    transition:
      width 0.25s ease,
      background 0.25s ease;
  }
  .fc-dot.is-active {
    width: 24px;
    background: var(--orange);
  }

  /* The mid-attack popup. */
  #fund-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  #fund-overlay[hidden] {
    display: none;
  }
  #fund-overlay .fund-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 4, 8, 0.8);
  }
  #fund-overlay .fund-card {
    position: relative;
    z-index: 1;
    max-width: 32rem;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    background: var(--panel);
    border: 1px solid var(--line-bright);
    border-radius: 14px;
    padding: 1.75rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--glow);
  }
  #fund-overlay .fund-close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    background: none;
    border: none;
    color: var(--dim);
    font-size: 1.1rem;
    cursor: pointer;
  }
  #fund-overlay h2 {
    margin: 0.25rem 0 1rem;
    font-size: 1.35rem;
  }
</style>
