---
import '@fontsource/saira/400.css'
import '@fontsource/saira/600.css'
import '@fontsource/saira/700.css'
import '@fontsource/saira/800.css'

interface Props {
  title: string
}
const { title } = Astro.props
const nav = [
  { href: '/', label: 'Home' },
  { href: '/attack', label: 'Attack the Network' },
  { href: '/fundamentals', label: 'Bitcoin Fundamentals' },
  { href: '/about', label: 'About' },
]
const current = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Attack Bitcoin yourself and watch what actually happens." />
    <title>{title} · Unkillable</title>
  </head>
  <body>
    <nav>
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={
              current === item.href || (item.href !== '/' && current.startsWith(item.href))
                ? 'page'
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #07090d;
    --panel: #10141b;
    --text: #e8e6e1;
    --dim: #8b8f98;
    --orange: #f7931a;
  }
  * {
    box-sizing: border-box;
  }
  html {
    overscroll-behavior-y: none;
  }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family:
      'Saira',
      system-ui,
      -apple-system,
      sans-serif;
    line-height: 1.5;
  }
  /* Type floor: nothing renders below 16px. Buttons and inputs default to the
     browser's 13px, and sup/sub to `smaller`, so they need saying explicitly.
     A page's own rule for a control still wins — this only sets the floor. */
  button,
  input,
  select,
  textarea {
    font-family: inherit;
    font-size: 1rem;
  }
  sup,
  sub {
    font-size: 1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #1c212b;
  }
  nav a {
    color: var(--dim);
    text-decoration: none;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    color: var(--orange);
  }
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  h1 {
    font-size: 2rem;
    letter-spacing: 0.01em;
  }
  a {
    color: var(--orange);
  }
  .stub {
    color: var(--dim);
    border: 1px dashed #2a3140;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-top: 1.5rem;
  }
  .cta {
    display: inline-block;
    background: var(--orange);
    color: #0a0a0a;
    font-weight: 700;
    font-size: 1.15rem;
    padding: 0.9rem 2rem;
    border-radius: 8px;
    text-decoration: none;
  }

  /* ---- Bitcoin Fundamentals shared pieces. The chapter carousel and the
     mid-attack popup are JS-mounted (innerHTML / set:html) and the popup can
     open on ANY page, so their styles live here, not in fundamentals.astro. */

  /* Text-only chapter visual (e.g. the big 21,000,000). */
  .fvisual .viz-row,
  #fund-body .viz-row {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0b0e14;
    border-radius: 8px;
    padding: 1rem;
  }
  .viz-big {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--orange);
    letter-spacing: 0.02em;
  }

  /* One idea at a time: arrows either side, dots along the bottom. */
  .fcarousel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .fc-viewport {
    min-height: 9rem;
    display: flex;
    align-items: center;
  }
  .fc-slide {
    display: none;
    width: 100%;
    color: var(--text);
    line-height: 1.6;
  }
  .fc-slide.is-active {
    display: block;
  }
  .fc-slide p {
    margin: 0 0 0.8rem;
  }
  .fc-slide p:last-child {
    margin-bottom: 0;
  }
  .fc-slide ul {
    margin: 0 0 0.8rem;
    padding-left: 1.2rem;
  }
  .fc-slide li {
    margin-bottom: 0.35rem;
  }
  /* The question that hands off to the next chapter. */
  .fc-slide .fhook {
    color: var(--orange);
    font-weight: 600;
  }
  .fc-arrow {
    background: none;
    border: none;
    color: var(--dim);
    font-size: 1.8rem;
    line-height: 1;
    padding: 0 0.25rem;
    cursor: pointer;
  }
  .fc-arrow:hover:not(:disabled) {
    color: var(--orange);
  }
  .fc-arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .fc-dots {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 0.9rem;
  }
  .fc-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: #2a3140;
    cursor: pointer;
  }
  .fc-dot.is-active {
    background: var(--orange);
  }

  /* The mid-attack popup. */
  #fund-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  #fund-overlay[hidden] {
    display: none;
  }
  #fund-overlay .fund-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 4, 8, 0.8);
  }
  #fund-overlay .fund-card {
    position: relative;
    z-index: 1;
    max-width: 32rem;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    background: var(--panel);
    border: 1px solid #2a3140;
    border-radius: 14px;
    padding: 1.75rem;
  }
  #fund-overlay .fund-close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    background: none;
    border: none;
    color: var(--dim);
    font-size: 1.1rem;
    cursor: pointer;
  }
  #fund-overlay h2 {
    margin: 0.25rem 0 1rem;
    font-size: 1.35rem;
  }
</style>
