---
import Base from '../layouts/Base.astro'
---

<Base title="Home">
  <p class="hero">
    Is bitcoin <strong class="hero-mark">unkillable</strong>? Attack the Network and see for
    yourself!
  </p>

  <!-- The observatory: the living globe. Drag to spin; nothing to click. -->
  <section id="observatory" aria-label="The Bitcoin network, live">
    <canvas id="globe" aria-hidden="true"></canvas>
  </section>

  <!-- The heartbeat: blockchain strip. Pure visual, nothing to click. -->
  <section id="strip" aria-label="The Bitcoin blockchain, arriving live">
    <div class="strip-head">
      <span id="tap-mode" class="mode">connecting…</span>
      <span id="countdown" class="countdown"></span>
    </div>
    <div class="blocks-row">
      <div id="blocks" class="blocks"></div>
      <!-- The block being assembled right now: fills from the mempool until
           it's minted and joins the chain to its left. -->
      <div id="next-block" class="next-block">
        <div class="cube next-cube"></div>
        <div class="binfo">
          <span class="height">next block</span>
          <span id="next-txs" class="txs">counting…</span>
        </div>
      </div>
    </div>
  </section>

  <p style="margin-top: 2.5rem; text-align: center">
    <a class="cta" href="/attack">Attack the Network</a>
  </p>

  <!-- The vitals panel: key numbers about the network right now. Floats at the
       right edge on wide screens, folds into the page flow on narrow ones. -->
  <aside id="vitals" aria-label="Bitcoin network vitals">
    <h2 class="v-title">Network vitals</h2>
    <dl class="v-list">
      <div class="v-row"><dt>Price</dt><dd id="v-price">—</dd></div>
      <div class="v-row"><dt>Block height</dt><dd id="v-height">—</dd></div>
      <div class="v-row"><dt>Hashrate</dt><dd id="v-hashrate">—</dd></div>
      <div class="v-row"><dt>Nodes online</dt><dd id="v-nodes">—</dd></div>
      <div class="v-row"><dt>Energy (est.)</dt><dd id="v-energy">—</dd></div>
      <div class="v-row"><dt>Coins mined</dt><dd id="v-supply">—</dd></div>
      <div class="v-row"><dt>Next halving</dt><dd id="v-halving">—</dd></div>
    </dl>
  </aside>
</Base>

<script>
  import { createDataTap, snapshotNodes, type BlockSummary } from '../tap/tap'
  import { createGlobe } from '../globe/globe'
  import {
    blocksToHalving,
    daysToHalving,
    estimatedGigawatts,
    supplyAtHeight,
  } from '../tap/derived'

  const tap = createDataTap()

  // --- The globe ------------------------------------------------------------
  // Node coordinates come from the bundled snapshot, not a live call: the
  // Bitnodes API sends no CORS header, so browsers can't read it, and node
  // geography barely shifts day to day. The reachable-node count lives in the
  // vitals panel.
  const globeCanvas = document.getElementById('globe') as HTMLCanvasElement | null
  if (globeCanvas) {
    createGlobe(globeCanvas, snapshotNodes().data.points, {
      autoRotateDegPerSec: 6,
      showTransactions: true,
    })
  }
  const modeEl = document.getElementById('tap-mode')!
  const countdownEl = document.getElementById('countdown')!
  const blocksEl = document.getElementById('blocks')!

  const SHOWN = 8 // tiles on screen
  const AVG_BLOCK_SECONDS = 600
  let shown: BlockSummary[] = []
  let newestTimestamp = 0
  let snapshotMode = false

  function tile(block: BlockSummary, fresh = false): HTMLElement {
    const el = document.createElement('div')
    el.className = 'block-tile' + (fresh ? ' fresh' : '')
    const size = block.sizeBytes ? `<span class="size">${(block.sizeBytes / 1e6).toFixed(2)} MB</span>` : ''
    el.innerHTML = `<div class="cube"></div><div class="binfo"><span class="height">#${block.height.toLocaleString('en-GB')}</span><span class="txs">${block.txCount.toLocaleString('en-GB')} payments</span>${size}</div>`
    el.title = `Block ${block.height.toLocaleString('en-GB')} — ${block.txCount.toLocaleString('en-GB')} payments`
    return el
  }

  // The assembling block fills from the mempool: how many payments are queued
  // waiting to be minted into the next block.
  const nextTxsEl = document.getElementById('next-txs')!
  async function refreshMempool() {
    const result = await tap.mempoolTxCount()
    const n = result.data.toLocaleString('en-GB')
    nextTxsEl.textContent =
      result.mode === 'live' ? `${n} waiting` : `~${n} waiting (${result.dataDate})`
  }

  // --- The vitals panel -----------------------------------------------------
  // Price and hashrate come from the tap; nodes from the bundled snapshot
  // (same CORS reason as the globe); energy, coins mined and the halving
  // countdown are pure maths on top of numbers we already have.
  const vEl = (id: string) => document.getElementById(id)!
  const fmt = (n: number) => n.toLocaleString('en-GB')

  function updateHeightVitals(height: number) {
    vEl('v-height').textContent = `#${fmt(height)}`
    const supply = supplyAtHeight(height)
    vEl('v-supply').textContent = `${(supply / 1e6).toFixed(2)}M of 21M`
    vEl('v-supply').title = `${fmt(Math.round(supply))} coins issued so far`
    const days = Math.round(daysToHalving(height))
    vEl('v-halving').textContent = `~${fmt(days)} days`
    vEl('v-halving').title = `${fmt(blocksToHalving(height))} blocks until the reward halves`
  }

  async function refreshVitals() {
    const [price, hashrate] = await Promise.all([tap.priceUSD(), tap.hashrateEH()])
    const approx = (r: { mode: string }) => (r.mode === 'live' ? '' : '~')
    vEl('v-price').textContent = `${approx(price)}$${fmt(Math.round(price.data))}`
    vEl('v-hashrate').textContent = `${approx(hashrate)}${fmt(Math.round(hashrate.data))} EH/s`
    vEl('v-energy').textContent = `~${Math.round(estimatedGigawatts(hashrate.data))} GW`
    vEl('v-energy').title =
      'Estimated: hashrate × typical miner efficiency. Nobody meters this directly.'
    const nodes = snapshotNodes()
    vEl('v-nodes').textContent = fmt(nodes.data.totalReachable)
  }

  function render(blocks: BlockSummary[]) {
    blocksEl.innerHTML = ''
    for (const b of blocks.slice(0, SHOWN)) blocksEl.appendChild(tile(b))
  }

  function arrive(block: BlockSummary) {
    shown.unshift(block)
    shown = shown.slice(0, SHOWN)
    const el = tile(block, true)
    blocksEl.prepend(el)
    while (blocksEl.children.length > SHOWN) blocksEl.lastElementChild!.remove()
    updateHeightVitals(block.height)
  }

  function tickCountdown() {
    if (newestTimestamp === 0) return
    const elapsed = Math.floor(Date.now() / 1000) - newestTimestamp
    const remaining = AVG_BLOCK_SECONDS - elapsed
    // Past the 10-minute average the timer goes negative rather than vague:
    // blocks are a lottery, and an overdue one is worth showing honestly.
    const abs = Math.abs(remaining)
    const m = Math.floor(abs / 60)
    const s = String(abs % 60).padStart(2, '0')
    countdownEl.textContent = `next block in ~${remaining < 0 ? '-' : ''}${m}:${s}`
    countdownEl.classList.toggle('overdue', remaining < 0)
  }

  async function refresh(first = false) {
    const result = await tap.recentBlocks()
    snapshotMode = result.mode === 'snapshot'
    modeEl.textContent = snapshotMode
      ? `snapshot from ${result.dataDate} — live feed unreachable`
      : 'LIVE'
    modeEl.classList.toggle('live', !snapshotMode)
    if (first) {
      shown = result.data.slice(0, SHOWN)
      // Miner-written timestamps drift (they're allowed to); never let one
      // sit in the future, or the countdown would start beyond 10:00.
      newestTimestamp = Math.min(shown[0]?.timestamp ?? 0, Math.floor(Date.now() / 1000))
      render(shown)
      if (shown[0]) updateHeightVitals(shown[0].height)
    } else if (result.data[0] && shown[0] && result.data[0].height > shown[0].height) {
      // Every block newer than what we're showing arrives, oldest-new first.
      const fresh = result.data
        .filter((b) => b.height > shown[0].height)
        .sort((a, b) => a.height - b.height)
      for (const b of fresh) arrive(b)
      // We witnessed this block land: our own clock beats the miner's
      // drift-prone timestamp as the countdown anchor.
      newestTimestamp = Math.floor(Date.now() / 1000)
    }
    // Snapshot mode: heartbeat is simulated from the snapshot's tip so the
    // strip still breathes; the banner above says exactly what it is.
    if (snapshotMode && first) {
      newestTimestamp = Math.floor(Date.now() / 1000) - 300 // mid-cycle
      setInterval(() => {
        const top = shown[0]
        if (!top) return
        arrive({
          id: 'simulated',
          height: top.height + 1,
          timestamp: Math.floor(Date.now() / 1000),
          txCount: 3000 + Math.floor(Math.random() * 1500),
        })
        newestTimestamp = Math.floor(Date.now() / 1000)
      }, AVG_BLOCK_SECONDS * 1000)
    }
  }

  refresh(true)
  refreshMempool()
  refreshVitals()
  setInterval(tickCountdown, 1000)
  setInterval(() => {
    if (!snapshotMode) {
      refresh()
      refreshMempool()
      refreshVitals()
    }
  }, 30_000)
</script>

<style>
  .hero {
    max-width: 44rem;
    margin: 0.5rem auto 0;
    text-align: center;
    font-size: 1.35rem;
    line-height: 1.55;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .hero .hero-mark {
    color: var(--orange);
    font-weight: 700;
  }
  #observatory {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  #globe {
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1 / 1;
    touch-action: pan-y;
    cursor: grab;
  }
  #globe:active {
    cursor: grabbing;
  }
  #strip {
    margin-top: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--glow);
  }
  .strip-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .mode {
    font-size: 1rem;
    color: var(--dim);
    letter-spacing: 0.05em;
  }
  .mode.live {
    color: #3fb950;
    font-weight: 700;
  }
  .mode.live::before {
    content: '●';
    margin-right: 0.35rem;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  .countdown {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--text);
  }
  /* Overdue: the timer has gone negative, the block is late. */
  .countdown.overdue {
    color: var(--orange);
  }
  .blocks-row {
    display: flex;
    align-items: stretch;
    gap: 1.1rem;
  }
  .blocks {
    display: flex;
    /* Newest block sits on the right (we read time left-to-right); the DOM
       keeps newest-first, row-reverse mirrors it and clips the oldest at the
       left edge. */
    flex-direction: row-reverse;
    gap: 1.1rem;
    overflow: hidden;
    flex: 1;
    min-width: 0;
    /* The oldest block dissolves into the past instead of clipping mid-tile. */
    mask-image: linear-gradient(90deg, transparent 0, #000 4.5rem);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 4.5rem);
  }
  /* The assembling block: a breathing orange cube, details underneath.
     Cube + binfo styles live in the global block, shared with the JS tiles. */
  .next-block {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  /* ---- The vitals panel. Floats at the right edge on wide screens; the
     media query below folds it into the page flow when there's no room. */
  #vitals {
    position: fixed;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    width: 14rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem 1.15rem 1.1rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--glow);
    z-index: 10;
  }
  .v-title {
    margin: 0 0 0.6rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .v-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .v-row dt {
    font-size: 1rem;
    color: var(--dim);
  }
  .v-row dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }
  #v-price {
    color: var(--orange);
  }
  /* No room to float: sit in the flow under the CTA as a wrapping grid. */
  @media (max-width: 1480px) {
    #vitals {
      position: static;
      transform: none;
      width: auto;
      margin-top: 2.5rem;
    }
    .v-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem 2rem;
    }
  }
</style>

<!-- Tiles are created in JS, so their styles must be global (scoped Astro
     styles only reach elements present in the template). Keyed under #blocks. -->
<style is:global>
  #blocks .block-tile {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  /* An isometric-ish cube: the div is the front face, ::before is the top
     face, ::after the right face. Extruded toward the top-right. */
  #strip .cube {
    position: relative;
    width: 38px;
    height: 38px;
    margin: 10px 10px 0 0;
    background: linear-gradient(160deg, #1a212d, #0c1017);
    border: 1px solid var(--line-bright);
  }
  #strip .cube::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 4px;
    width: 100%;
    height: 9px;
    background: #232c3b;
    border: 1px solid var(--line-bright);
    transform: skewX(-45deg);
  }
  #strip .cube::after {
    content: '';
    position: absolute;
    top: -5px;
    right: -10px;
    width: 9px;
    height: 100%;
    background: #0a0d13;
    border: 1px solid var(--line-bright);
    transform: skewY(-45deg);
  }
  /* Simple white lines tying the chain together, at cube mid-height. The
     cube column is 48px tall (38px face + 10px extrusion margin), so the
     visual centre sits ~29px down. */
  #blocks .block-tile:not(:last-child)::before,
  #strip .next-block::before {
    content: '';
    position: absolute;
    left: -1.2rem;
    top: 29px;
    width: 1.3rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.45);
  }
  #blocks .block-tile.fresh {
    animation: block-slide-in 0.6s ease-out;
  }
  #blocks .block-tile.fresh .cube,
  #blocks .block-tile.fresh .cube::before,
  #blocks .block-tile.fresh .cube::after {
    border-color: var(--orange);
  }
  #blocks .block-tile.fresh .cube {
    box-shadow: var(--glow);
  }
  @keyframes block-slide-in {
    from {
      transform: translateX(1.5rem);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  /* The assembling cube breathes orange until it's minted. */
  #strip .next-cube,
  #strip .next-cube::before,
  #strip .next-cube::after {
    border-color: rgba(247, 147, 26, 0.55);
  }
  #strip .next-cube {
    animation: assemble-pulse 2.4s ease-in-out infinite;
  }
  @keyframes assemble-pulse {
    0%,
    100% {
      box-shadow: 0 0 6px rgba(247, 147, 26, 0.1);
    }
    50% {
      box-shadow: 0 0 18px rgba(247, 147, 26, 0.35);
    }
  }
  /* Block details sit under the cube. 12px on Laurence's explicit call —
     the one sanctioned exception to the 16px type floor. */
  #strip .binfo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
  }
  #strip .binfo .height {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 12px;
    color: var(--text);
  }
  #strip .binfo .txs {
    font-size: 12px;
    color: var(--dim);
  }
  #strip .binfo .size {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
  }
  #strip .next-block .binfo .height {
    color: var(--orange);
  }
</style>
