---
import Base from '../layouts/Base.astro'
---

<Base title="Home">
  <p class="hero">
    Bitcoin has been hacked, banned, bought, unplugged and declared dead
    <strong class="hero-mark">477 times</strong> — in headlines. Here you get the weapons to try
    it yourself.
  </p>

  <!-- The observatory: the living globe. Drag to spin; nothing to click. -->
  <section id="observatory" aria-label="The Bitcoin network, live">
    <canvas id="globe" aria-hidden="true"></canvas>
    <p id="node-count" class="node-count">counting nodes…</p>
  </section>

  <!-- The heartbeat: blockchain strip. Pure visual, nothing to click. -->
  <section id="strip" aria-label="The Bitcoin blockchain, arriving live">
    <div class="strip-head">
      <span id="tap-mode" class="mode">connecting…</span>
      <span id="countdown" class="countdown"></span>
    </div>
    <div class="blocks-row">
      <!-- The block being assembled right now: fills from the mempool until
           it's minted and joins the chain to its right. -->
      <div id="next-block" class="next-block">
        <span class="height">next block</span>
        <span id="next-txs" class="txs">counting…</span>
      </div>
      <div id="blocks" class="blocks"></div>
    </div>
    <p class="strip-note">
      One new block roughly every 10 minutes — an average, not a schedule. Some arrive in
      seconds, some take an hour.
    </p>
  </section>

  <p style="margin-top: 2.5rem">
    <a class="cta" href="/attack">Attack the Network</a>
  </p>
</Base>

<script>
  import { createDataTap, snapshotNodes, type BlockSummary } from '../tap/tap'
  import { createGlobe } from '../globe/globe'

  const tap = createDataTap()

  // --- The globe ------------------------------------------------------------
  // Node coordinates come from the bundled snapshot, not a live call: the
  // Bitnodes API sends no CORS header, so browsers can't read it, and node
  // geography barely shifts day to day. We show the reachable-node count and
  // the snapshot's month so the number is honest and dated (honesty pledge).
  const globeCanvas = document.getElementById('globe') as HTMLCanvasElement | null
  const nodeCountEl = document.getElementById('node-count')
  if (globeCanvas) {
    const res = snapshotNodes()
    createGlobe(globeCanvas, res.data.points, {
      autoRotateDegPerSec: 6,
      showTransactions: true,
    })
    if (nodeCountEl) {
      const total = res.data.totalReachable.toLocaleString('en-GB')
      const month = new Date(res.dataDate + 'T00:00:00Z').toLocaleDateString('en-GB', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      })
      nodeCountEl.textContent = `${total} reachable nodes worldwide (${month}) — drag to spin the Earth`
    }
  }
  const modeEl = document.getElementById('tap-mode')!
  const countdownEl = document.getElementById('countdown')!
  const blocksEl = document.getElementById('blocks')!

  const SHOWN = 8 // tiles on screen
  const AVG_BLOCK_SECONDS = 600
  let shown: BlockSummary[] = []
  let newestTimestamp = 0
  let snapshotMode = false

  function tile(block: BlockSummary, fresh = false): HTMLElement {
    const el = document.createElement('div')
    el.className = 'block-tile' + (fresh ? ' fresh' : '')
    const size = block.sizeBytes ? `<span class="size">${(block.sizeBytes / 1e6).toFixed(2)} MB</span>` : ''
    el.innerHTML = `<span class="height">#${block.height.toLocaleString('en-GB')}</span><span class="txs">${block.txCount.toLocaleString('en-GB')} payments</span>${size}`
    el.title = `Block ${block.height.toLocaleString('en-GB')} — ${block.txCount.toLocaleString('en-GB')} payments`
    return el
  }

  // The assembling block fills from the mempool: how many payments are queued
  // waiting to be minted into the next block.
  const nextTxsEl = document.getElementById('next-txs')!
  async function refreshMempool() {
    const result = await tap.mempoolTxCount()
    const n = result.data.toLocaleString('en-GB')
    nextTxsEl.textContent =
      result.mode === 'live' ? `${n} waiting` : `~${n} waiting (${result.dataDate})`
  }

  function render(blocks: BlockSummary[]) {
    blocksEl.innerHTML = ''
    for (const b of blocks.slice(0, SHOWN)) blocksEl.appendChild(tile(b))
  }

  function arrive(block: BlockSummary) {
    shown.unshift(block)
    shown = shown.slice(0, SHOWN)
    const el = tile(block, true)
    blocksEl.prepend(el)
    while (blocksEl.children.length > SHOWN) blocksEl.lastElementChild!.remove()
  }

  function tickCountdown() {
    if (newestTimestamp === 0) return
    const elapsed = Math.floor(Date.now() / 1000) - newestTimestamp
    const remaining = AVG_BLOCK_SECONDS - elapsed
    if (remaining > 0) {
      const m = Math.floor(remaining / 60)
      const s = String(remaining % 60).padStart(2, '0')
      countdownEl.textContent = `next block in ~${m}:${s}`
    } else {
      countdownEl.textContent = 'next block: any moment now'
    }
  }

  async function refresh(first = false) {
    const result = await tap.recentBlocks()
    snapshotMode = result.mode === 'snapshot'
    modeEl.textContent = snapshotMode
      ? `snapshot from ${result.dataDate} — live feed unreachable`
      : 'LIVE'
    modeEl.classList.toggle('live', !snapshotMode)
    if (first) {
      shown = result.data.slice(0, SHOWN)
      newestTimestamp = shown[0]?.timestamp ?? 0
      render(shown)
    } else if (result.data[0] && shown[0] && result.data[0].height > shown[0].height) {
      // Every block newer than what we're showing arrives, oldest-new first.
      const fresh = result.data
        .filter((b) => b.height > shown[0].height)
        .sort((a, b) => a.height - b.height)
      for (const b of fresh) arrive(b)
      newestTimestamp = shown[0].timestamp
    }
    // Snapshot mode: heartbeat is simulated from the snapshot's tip so the
    // strip still breathes; the banner above says exactly what it is.
    if (snapshotMode && first) {
      newestTimestamp = Math.floor(Date.now() / 1000) - 300 // mid-cycle
      setInterval(() => {
        const top = shown[0]
        if (!top) return
        arrive({
          id: 'simulated',
          height: top.height + 1,
          timestamp: Math.floor(Date.now() / 1000),
          txCount: 3000 + Math.floor(Math.random() * 1500),
        })
        newestTimestamp = Math.floor(Date.now() / 1000)
      }, AVG_BLOCK_SECONDS * 1000)
    }
  }

  refresh(true)
  refreshMempool()
  setInterval(tickCountdown, 1000)
  setInterval(() => {
    if (!snapshotMode) {
      refresh()
      refreshMempool()
    }
  }, 30_000)
</script>

<style>
  .hero {
    max-width: 44rem;
    margin: 0.5rem auto 0;
    text-align: center;
    font-size: 1.35rem;
    line-height: 1.55;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .hero .hero-mark {
    color: var(--orange);
    font-weight: 700;
  }
  #observatory {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  #globe {
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1 / 1;
    touch-action: pan-y;
    cursor: grab;
  }
  #globe:active {
    cursor: grabbing;
  }
  .node-count {
    margin: 0.25rem 0 0;
    font-size: 1rem;
    color: var(--dim);
    text-align: center;
  }
  #strip {
    margin-top: 2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--glow);
  }
  .strip-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .mode {
    font-size: 1rem;
    color: var(--dim);
    letter-spacing: 0.05em;
  }
  .mode.live {
    color: #3fb950;
    font-weight: 700;
  }
  .mode.live::before {
    content: '●';
    margin-right: 0.35rem;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  .countdown {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--text);
  }
  .blocks-row {
    display: flex;
    align-items: stretch;
    gap: 1.1rem;
  }
  .blocks {
    display: flex;
    gap: 1.1rem;
    overflow: hidden;
    flex: 1;
    min-width: 0;
  }
  /* The block being assembled: dashed, breathing, waiting to be minted. */
  .next-block {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    justify-content: center;
    border: 1px dashed rgba(247, 147, 26, 0.55);
    border-radius: 6px;
    padding: 0.6rem 0.85rem;
    white-space: nowrap;
    animation: assemble-pulse 2.4s ease-in-out infinite;
  }
  .next-block .height {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--orange);
  }
  .next-block .txs {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--dim);
  }
  @keyframes assemble-pulse {
    0%,
    100% {
      box-shadow: 0 0 6px rgba(247, 147, 26, 0.1);
      border-color: rgba(247, 147, 26, 0.35);
    }
    50% {
      box-shadow: 0 0 16px rgba(247, 147, 26, 0.3);
      border-color: rgba(247, 147, 26, 0.7);
    }
  }
  .strip-note {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    color: var(--dim);
  }
</style>

<!-- Tiles are created in JS, so their styles must be global (scoped Astro
     styles only reach elements present in the template). Keyed under #blocks. -->
<style is:global>
  #blocks .block-tile {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--well);
    border: 1px solid var(--line-bright);
    border-radius: 6px;
    padding: 0.6rem 0.85rem;
    white-space: nowrap;
  }
  /* Chain links: each block points at the one it builds on (to its right —
     newest arrives on the left). */
  #blocks .block-tile:not(:last-child)::after {
    content: '›';
    position: absolute;
    right: -0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(247, 147, 26, 0.5);
    font-size: 1.1rem;
    line-height: 1;
  }
  #blocks .block-tile.fresh {
    animation: block-slide-in 0.6s ease-out;
    border-color: var(--orange);
  }
  @keyframes block-slide-in {
    from {
      transform: translateX(-1.5rem);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  #blocks .block-tile .height {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1rem;
  }
  #blocks .block-tile .txs {
    font-size: 1rem;
    color: var(--dim);
  }
  #blocks .block-tile .size {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--dim);
  }
</style>
