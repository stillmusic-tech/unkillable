---
import Base from '../../layouts/Base.astro'
---

<Base title="Print more of it">
  <p class="brief">
    Every currency in history got printed into worthlessness. Bitcoin is just software — so
    open it up and give yourself some. Who's going to stop you?
  </p>
  <p class="ground">
    You're a miner now: your job is to write the next page of Bitcoin's record book.
    <a href="/fundamentals#mining" data-card="mining">What is Bitcoin mining?</a>
  </p>

  <div class="scoreboard">
    <div class="sb-item">
      <span class="sb-label">Bitcoin that will ever exist</span>
      <span class="sb-value fixed">21,000,000</span>
    </div>
    <div class="sb-item">
      <span class="sb-label">Blocks accepted</span>
      <span class="sb-value" id="accepted">0</span>
    </div>
    <div class="sb-item">
      <span class="sb-label">Blocks rejected</span>
      <span class="sb-value reject" id="rejected">0</span>
    </div>
  </div>

  <div class="desk">
    <!-- Cheat menu. -->
    <div class="cheats" id="cheats" role="group" aria-label="Cheat menu"></div>

    <!-- The block being written. -->
    <div class="block-editor">
      <div class="block-head">
        <span>The next block — <span id="block-title">an honest block</span></span>
      </div>
      <dl class="block-body" id="block-body"></dl>
      <button id="submit" class="submit">Submit to the network ▶</button>
      <p class="wink">
        Simplified — the real rulebook has hundreds of checks. They all fail you just as fast.
      </p>
    </div>
  </div>

  <!-- Network verdict lights. -->
  <div class="verdict-wrap">
    <canvas id="nodes" aria-hidden="true"></canvas>
    <div class="chain" id="chain" aria-label="The accepted chain"></div>
  </div>

  <div id="toasts" class="toasts" aria-live="polite"></div>

  <!-- The 2017 receipt. -->
  <section class="receipt" id="receipt">
    <button id="receipt-btn" class="receipt-btn">▶ This was actually tried (2017)</button>
    <div id="receipt-story" class="receipt-story" hidden></div>
  </section>

  <!-- The door (revealed after first submit). -->
  <section id="turn" class="turn" hidden>
    <p class="turn-line" id="turn-line"></p>
    <a class="cta" href="/attack/time">Can't cheat it either? Fine — just wait. →</a>
  </section>

  <details class="footnote">
    <summary>So the rules can NEVER change?</summary>
    <p>
      They can — Bitcoin's software has been upgraded many times. But a change only happens
      when essentially <em>everyone opts in voluntarily</em>; nobody can decree one. Dissenters
      can keep the old rules, and anyone can copy the code and launch a 42-million-coin
      version — thousands have. A “Bitcoin” with a different cap simply isn't Bitcoin, and
      markets price it accordingly. The cap is safe not because change is impossible, but
      because this change has no constituency: it asks the holders of 21-million-capped money
      to vote themselves poorer.
    </p>
  </details>
</Base>

<script>
  import {
    CHEATS,
    blockForCheat,
    evaluateCheat,
    type CheatId,
    type Verdict,
  } from '../../engines/counterfeit/engine'
  import { snapshotNodes } from '../../tap/tap'
  import { browserStorage, markAttempted } from '../../progress/progress'
  import { initFundamentals } from '../../fundamentals/overlay'

  const $ = (id: string) => document.getElementById(id)!
  let current: CheatId = 'straight'
  let accepted = 0
  let rejected = 0
  let submittedOnce = false
  let animating = false

  // Cheat menu.
  const cheatsEl = $('cheats')
  for (const cheat of CHEATS) {
    const btn = document.createElement('button')
    btn.className = 'cheat'
    btn.dataset.cheat = cheat.id
    btn.innerHTML = `<span class="cheat-icon">${cheat.icon}</span><span>${cheat.label}</span>`
    btn.addEventListener('click', () => select(cheat.id))
    cheatsEl.appendChild(btn)
  }

  function select(id: CheatId) {
    current = id
    document.querySelectorAll('.cheat').forEach((b) => b.classList.remove('armed'))
    document.querySelector(`.cheat[data-cheat="${id}"]`)?.classList.add('armed')
    renderBlock()
  }

  const TITLES: Record<CheatId, string> = {
    straight: 'an honest block',
    triple: 'a block that triples your pay',
    overcap: 'a block that mints coin 21,000,001',
    steal: "a block that spends a stranger's coins",
  }

  function renderBlock() {
    const b = blockForCheat(current)
    $('block-title').textContent = TITLES[current]
    const rows: [string, string, boolean][] = [
      ['Your reward', `${b.rewardBtc} BTC`, current === 'triple'],
      [
        'New coins created',
        current === 'overcap' ? 'past the 21,000,000 cap' : '3.125 BTC (the subsidy)',
        current === 'overcap',
      ],
      [
        'A payment inside the block',
        current === 'steal' ? "moving a stranger's coins (no signature)" : 'ordinary user payments',
        current === 'steal',
      ],
    ]
    $('block-body').innerHTML = rows
      .map(([k, v, bad]) => `<div class="row${bad ? ' bad' : ''}"><dt>${k}</dt><dd>${v}</dd></div>`)
      .join('')
  }

  // Verdict lights — a grid of node dots that flick to the verdict colour.
  const canvas = $('nodes') as HTMLCanvasElement
  const ctx = canvas.getContext('2d')!
  const NODE_COUNT = 320
  const totalNodes = snapshotNodes().data.totalReachable
  let dots: { x: number; y: number; lit: number }[] = [] // lit: 0 idle, 1 green, -1 red
  function layoutDots() {
    const rect = canvas.getBoundingClientRect()
    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    canvas.width = rect.width * dpr
    canvas.height = rect.height * dpr
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    const cols = Math.ceil(Math.sqrt((NODE_COUNT * rect.width) / rect.height))
    const rows = Math.ceil(NODE_COUNT / cols)
    dots = []
    for (let i = 0; i < NODE_COUNT; i++) {
      const c = i % cols
      const r = Math.floor(i / cols)
      dots.push({ x: ((c + 0.5) / cols) * rect.width, y: ((r + 0.5) / rows) * rect.height, lit: 0 })
    }
    drawDots()
  }
  function drawDots() {
    const rect = canvas.getBoundingClientRect()
    ctx.clearRect(0, 0, rect.width, rect.height)
    for (const d of dots) {
      ctx.beginPath()
      ctx.arc(d.x, d.y, 3, 0, Math.PI * 2)
      ctx.fillStyle =
        d.lit === 1
          ? 'rgba(63,185,80,0.95)'
          : d.lit === -1
            ? 'rgba(255,80,80,0.95)'
            : 'rgba(120,130,150,0.4)'
      ctx.fill()
    }
  }

  function flick(verdict: Verdict, done: () => void) {
    animating = true
    for (const d of dots) d.lit = 0
    drawDots()
    let i = 0
    const BATCH = 12
    function step() {
      for (let k = 0; k < BATCH && i < dots.length; k++, i++) {
        dots[i].lit = verdict.accepted ? 1 : -1
      }
      drawDots()
      if (i < dots.length) requestAnimationFrame(step)
      else if (animating) {
        animating = false
        done()
      }
    }
    // Guarantee completion even if the tab is backgrounded (rAF throttled).
    setTimeout(() => {
      if (!animating) return
      for (const d of dots) d.lit = verdict.accepted ? 1 : -1
      drawDots()
      animating = false
      done()
    }, 900)
    requestAnimationFrame(step)
  }

  function toast(msg: string, ms = 5500) {
    const el = document.createElement('div')
    el.className = 'toast'
    el.textContent = msg
    $('toasts').appendChild(el)
    setTimeout(() => el.classList.add('show'), 10)
    setTimeout(() => {
      el.classList.remove('show')
      setTimeout(() => el.remove(), 400)
    }, ms)
  }

  $('submit').addEventListener('click', () => {
    if (animating) return
    const verdict = evaluateCheat(current)
    flick(verdict, () => {
      if (verdict.accepted) {
        accepted++
        $('accepted').textContent = String(accepted)
        addChainBlock()
        toast('Accepted. Welcome to mining. This is the only version of you the network will ever pay.')
      } else {
        rejected++
        $('rejected').textContent = String(rejected)
        toast(
          `Rejected by ${totalNodes.toLocaleString('en-GB')} independent bookkeepers in 0.4 seconds. No committee met. No vote was held. ${verdict.reason}`,
          7000,
        )
        if (current === 'steal') {
          setTimeout(
            () =>
              toast(
                'Their coins are locked by their key — you couldn’t pick that lock in Attack 1 either.',
                5500,
              ),
            700,
          )
        }
      }
      firstSubmit()
    })
  })

  function addChainBlock() {
    const el = document.createElement('div')
    el.className = 'chain-block'
    el.textContent = '⛏'
    $('chain').appendChild(el)
  }

  function firstSubmit() {
    if (submittedOnce) return
    submittedOnce = true
    markAttempted(browserStorage(), 'print')
    const turn = $('turn') as HTMLElement
    $('turn-line').textContent =
      'There’s no central bank to lobby. The 21 million cap isn’t a policy anyone decided to enforce today — it’s what every copy of the software checks, everywhere, forever. To print money you wouldn’t hack Bitcoin. You’d have to talk every node on Earth into downloading different rules.'
    turn.hidden = false
  }

  // The 2017 receipt — a stepped real-history reveal.
  const STORY = [
    'In 2017, most of the mining industry and many of the biggest companies agreed together to change Bitcoin’s rules.',
    'Ordinary users kept running the old software. Their nodes simply refused the new version.',
    'With no one able to force the change, it died. The dissenters split off into a separate coin.',
    'That coin trades today at a small fraction of Bitcoin’s value. The suits lost to the rulebook.',
  ]
  $('receipt-btn').addEventListener('click', () => {
    const box = $('receipt-story') as HTMLElement
    box.hidden = false
    box.innerHTML = ''
    ;($('receipt-btn') as HTMLButtonElement).disabled = true
    STORY.forEach((line, i) => {
      const p = document.createElement('p')
      p.textContent = line
      p.className = 'story-line'
      box.appendChild(p)
      setTimeout(() => p.classList.add('show'), 400 + i * 1200)
    })
  })

  select('straight')
  layoutDots()
  window.addEventListener('resize', layoutDots)
  // Inline "term" links open the Fundamentals card as an overlay in place.
  initFundamentals()
</script>

<style>
  .brief {
    font-size: 1.2rem;
    color: var(--text);
    margin: 0.25rem 0 0.75rem;
  }
  .ground {
    color: var(--dim);
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }
  .scoreboard {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    background: var(--panel);
    border: 1px solid #1c212b;
    border-radius: 10px;
    padding: 0.9rem 1.15rem;
  }
  .sb-item {
    display: flex;
    flex-direction: column;
  }
  .sb-label {
    font-size: 0.7rem;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .sb-value {
    font-size: 1.4rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .sb-value.fixed {
    color: var(--orange);
  }
  .sb-value.reject {
    color: #ff6b6b;
  }
  .desk {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) 2fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .block-editor {
    background: var(--panel);
    border: 1px solid #1c212b;
    border-radius: 10px;
    padding: 1.1rem 1.25rem;
  }
  .block-head {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .block-body {
    margin: 0 0 1rem;
  }
  .submit {
    width: 100%;
    background: var(--orange);
    color: #0a0a0a;
    font-weight: 700;
    font-size: 1.05rem;
    border: none;
    border-radius: 8px;
    padding: 0.8rem;
    cursor: pointer;
  }
  .wink {
    font-size: 0.72rem;
    color: var(--dim);
    margin: 0.6rem 0 0;
    text-align: center;
  }
  .verdict-wrap {
    margin-top: 1.25rem;
  }
  #nodes {
    width: 100%;
    height: 9rem;
    display: block;
  }
  .chain {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.6rem;
    min-height: 1.9rem;
  }
  .turn {
    margin-top: 1.75rem;
    text-align: center;
  }
  .turn-line {
    font-size: 1.2rem;
    max-width: 42rem;
    margin: 0 auto 1.25rem;
  }
  .receipt {
    margin-top: 1.75rem;
  }
  .receipt-btn {
    background: #0f141c;
    border: 1px solid #2a3140;
    color: var(--text);
    border-radius: 8px;
    padding: 0.6rem 1rem;
    cursor: pointer;
    font-size: 0.95rem;
  }
  .receipt-btn:hover:not(:disabled) {
    border-color: var(--orange);
  }
  .receipt-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .receipt-story {
    margin-top: 1rem;
    border-left: 2px solid var(--orange);
    padding-left: 1rem;
  }
  .footnote {
    margin-top: 2rem;
    border-top: 1px solid #1c212b;
    padding-top: 1rem;
    color: var(--dim);
  }
  .footnote summary {
    cursor: pointer;
    color: var(--text);
  }
  .footnote p {
    font-size: 0.9rem;
  }
  @media (max-width: 34rem) {
    .desk {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- JS-built elements need global styles. -->
<style is:global>
  #cheats {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  #cheats .cheat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #0f141c;
    border: 1px solid #2a3140;
    color: var(--text);
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
    cursor: pointer;
    text-align: left;
    font-size: 0.9rem;
  }
  #cheats .cheat:hover {
    border-color: var(--orange);
  }
  #cheats .cheat.armed {
    border-color: var(--orange);
    background: #241a0c;
  }
  #cheats .cheat-icon {
    font-size: 1.2rem;
  }
  #block-body .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid #171c25;
  }
  #block-body dt {
    color: var(--dim);
    font-size: 0.85rem;
  }
  #block-body dd {
    margin: 0;
    font-size: 0.9rem;
    text-align: right;
  }
  #block-body .row.bad dd {
    color: #ff6b6b;
    font-weight: 600;
  }
  #chain .chain-block {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    background: #12331c;
    border: 1px solid #3fb950;
    border-radius: 5px;
    font-size: 0.9rem;
  }
  #receipt-story .story-line {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.5s,
      transform 0.5s;
    font-size: 0.95rem;
    margin: 0.5rem 0;
  }
  #receipt-story .story-line.show {
    opacity: 1;
    transform: none;
  }
  #toasts {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: min(92%, 34rem);
    pointer-events: none;
    z-index: 20;
  }
  #toasts .toast {
    background: rgba(16, 20, 27, 0.96);
    border: 1px solid #2a3140;
    border-left: 3px solid var(--orange);
    border-radius: 6px;
    padding: 0.65rem 0.9rem;
    font-size: 0.9rem;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  #toasts .toast.show {
    opacity: 1;
    transform: none;
  }
</style>
