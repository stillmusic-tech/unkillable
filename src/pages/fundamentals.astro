---
import Base from '../layouts/Base.astro'
import { CARDS } from '../fundamentals/cards'
import { carouselHTML } from '../fundamentals/carousel'
---

<Base title="Bitcoin Fundamentals">
  <div class="ladder">
    {
      CARDS.map((card, i) => (
        <section class="fchapter">
          <article class="fcard" id={card.id}>
            <div class="fcard-head">
              <span class="fnum">{i + 1}</span>
              <h2>{card.title}</h2>
            </div>
            {card.visual && <div class="fvisual" set:html={card.visual} />}
            <div class="fbody" set:html={carouselHTML(card.slides)} />
            <a class="fattack" href={card.attackHref}>
              {card.attackLabel}
            </a>
          </article>
        </section>
      ))
    }
  </div>

  <aside id="fund-rail" aria-label="Chapters">
    {
      CARDS.map((card, i) => (
        <button class="rail-item" data-target={card.id}>
          <span class="rail-num">{i + 1}</span>
          <span class="rail-title">{card.title}</span>
        </button>
      ))
    }
  </aside>
</Base>

<script>
  import { initFundamentals } from '../fundamentals/overlay'
  import { initRail } from '../fundamentals/rail'
  import { initCarousel } from '../fundamentals/carousel'
  initFundamentals()
  initRail()
  document.querySelectorAll<HTMLElement>('.fbody .fcarousel').forEach(initCarousel)
</script>

<style>
  .fchapter {
    min-height: calc(100svh - var(--navh, 3.5rem));
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
    padding: 2rem 1.5rem;
  }
  .fcard {
    width: 100%;
    max-width: 42rem;
    background: var(--panel);
    border: 1px solid #1c212b;
    border-radius: 12px;
    padding: 1.5rem;
  }
  #fund-rail {
    position: fixed;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    max-width: 16rem;
    background: var(--panel);
    border: 1px solid #1c212b;
    border-radius: 12px;
    padding: 0.6rem;
  }
  .rail-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    border-radius: 8px;
    padding: 0.45rem 0.6rem;
    color: var(--dim);
    font-family: inherit;
    font-size: 0.8rem;
    text-align: left;
    cursor: pointer;
  }
  .rail-item:hover {
    color: var(--text);
    background: #0b0e14;
  }
  .rail-num {
    width: 1.3rem;
    height: 1.3rem;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #0b0e14;
    border: 1px solid #2a3140;
    font-size: 0.7rem;
  }
  .rail-item.active {
    color: var(--orange);
  }
  .rail-item.active .rail-num {
    border-color: var(--orange);
    color: var(--orange);
  }
  @media (max-width: 68rem) {
    #fund-rail {
      display: none;
    }
  }
  .fcard-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .fnum {
    width: 1.6rem;
    height: 1.6rem;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #0b0e14;
    border: 1px solid #2a3140;
    font-size: 0.85rem;
    color: var(--dim);
  }
  .fcard-head h2 {
    font-size: 1.2rem;
    margin: 0;
  }
  .fattack {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--orange);
    font-weight: 600;
    text-decoration: none;
  }
  .fattack:hover {
    text-decoration: underline;
  }
</style>

<style is:global>
  /* One chapter at a time: the page scroll snaps to chapter tops. Scoped to
     this page via the rail's presence; main's default width/padding give way
     to the full-height chapters. */
  html:has(#fund-rail) {
    scroll-snap-type: y mandatory;
    scroll-padding-top: var(--navh, 3.5rem);
  }
  /* Keep the top menu pinned while snapping between chapters. --navh is set
     by rail.ts from the nav's real height (it wraps on narrow screens). */
  html:has(#fund-rail) nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--bg);
  }
  html:has(#fund-rail) main {
    max-width: none;
    margin: 0;
    padding: 0;
  }
</style>

<!-- Card visuals, the carousel, and the popup are shared/JS-mounted and can
     open on any page, so their styles live in Base.astro's global block. -->
