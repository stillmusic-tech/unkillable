---
import Base from '../layouts/Base.astro'
import { CARDS } from '../fundamentals/cards'
import { carouselHTML } from '../fundamentals/carousel'
---

<Base title="Bitcoin Fundamentals">
  <div class="ladder">
    {
      CARDS.map((card, i) => (
        <section class="fchapter">
          <article class="fcard" id={card.id}>
            <div class="fcard-head">
              <span class="fnum">{String(i + 1).padStart(2, '0')}</span>
              <h2>{card.title}</h2>
            </div>
            {card.visual && <div class="fvisual" set:html={card.visual} />}
            <div class="fbody" set:html={carouselHTML(card.slides)} />
          </article>
        </section>
      ))
    }
  </div>

  <aside id="fund-rail" aria-label="Chapters">
    {
      CARDS.map((card, i) => (
        <button class="rail-item" data-target={card.id}>
          <span class="rail-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="rail-title">{card.title}</span>
        </button>
      ))
    }
  </aside>
</Base>

<script>
  import { initFundamentals } from '../fundamentals/overlay'
  import { initRail } from '../fundamentals/rail'
  import { initCarousel } from '../fundamentals/carousel'
  initFundamentals()
  initRail()
  document.querySelectorAll<HTMLElement>('.fbody .fcarousel').forEach(initCarousel)

  // Left/right arrows step the carousel of the chapter in view (up/down
  // already scrolls between chapters natively). When the overlay is open it
  // handles its own arrow keys, so stay out of the way.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
    const overlay = document.getElementById('fund-overlay')
    if (overlay && !overlay.hidden) return
    let best: Element | null = null
    let bestDist = Infinity
    document.querySelectorAll('.fchapter').forEach((s) => {
      const dist = Math.abs(s.getBoundingClientRect().top)
      if (dist < bestDist) {
        bestDist = dist
        best = s
      }
    })
    best
      ?.querySelector<HTMLButtonElement>(e.key === 'ArrowLeft' ? '.fc-prev' : '.fc-next')
      ?.click()
  })
</script>

<style>
  .fchapter {
    min-height: calc(100svh - var(--navh, 3.5rem));
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
    padding: 2rem 1.5rem;
  }
  .fcard {
    width: 100%;
    max-width: 46rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.75rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--glow);
  }
  /* The chapter rail is anchored flush to the screen edge, not floating. */
  #fund-rail {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-width: 16rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-right: none;
    border-radius: 12px 0 0 12px;
    padding: 0.75rem 0.75rem 0.75rem 0.6rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  /* Each item carries a vertical step line at its left; the lines light up
     orange as you advance — dimmer for chapters already passed, full for the
     one on screen. */
  .rail-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: none;
    border-radius: 0 8px 8px 0;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    color: var(--dim);
    font-family: inherit;
    font-size: 1rem;
    text-align: left;
    cursor: pointer;
  }
  .rail-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    bottom: 3px;
    width: 2px;
    border-radius: 1px;
    background: var(--line-bright);
  }
  .rail-item:hover {
    color: var(--text);
    background: var(--well);
  }
  .rail-num {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 1rem;
  }
  .rail-item.active {
    color: var(--orange);
  }
  .rail-item.active::before {
    background: var(--orange);
  }
  .rail-item:has(~ .rail-item.active)::before {
    background: rgba(247, 147, 26, 0.4);
  }
  @media (max-width: 68rem) {
    #fund-rail {
      display: none;
    }
  }
  .fcard-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .fnum {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--orange);
  }
  .fcard-head h2 {
    font-size: 1.25rem;
    margin: 0;
  }
</style>

<style is:global>
  /* One chapter at a time: the page scroll snaps to chapter tops. Scoped to
     this page via the rail's presence; main's default width/padding give way
     to the full-height chapters. */
  html:has(#fund-rail) {
    scroll-snap-type: y mandatory;
    scroll-padding-top: var(--navh, 3.5rem);
  }
  /* Keep the top menu pinned while snapping between chapters. --navh is set
     by rail.ts from the nav's real height (it wraps on narrow screens). */
  html:has(#fund-rail) nav {
    position: sticky;
    top: 0;
    z-index: 60;
  }
  html:has(#fund-rail) main {
    max-width: none;
    margin: 0;
    padding: 0;
  }
</style>

<!-- Card visuals, the carousel, and the popup are shared/JS-mounted and can
     open on any page, so their styles live in Base.astro's global block. -->
